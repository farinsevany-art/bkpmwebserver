{
  "info": {
    "_postman_id": "00dbab61-3edc-424c-93e8-d57e329960ba",
    "name": "API Sistem Informasi Akademik (Acara 21)",
    "description": "Autentikasi register/login dan CRUD mahasiswa berbasis NIM.",
